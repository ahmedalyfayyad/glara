generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Serverless functions open a connection per invocation, so the app talks to
  // the pooler. Migrations need a real session, which the pooler cannot give.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Product {
  id            String  @id @default(cuid())
  slug          String  @unique
  name          String
  nameAr        String
  collection    String // Linea, Aria, Nova ...
  collectionAr  String
  type          String // vanity | storage | mirror
  tagline       String
  taglineAr     String
  description   String
  descriptionAr String

  basePrice Int // integer, in the store currency's major unit
  featured  Boolean @default(false)
  isNew     Boolean @default(false)
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  materials      String
  materialsAr    String
  installation   String
  installationAr String
  warranty       String
  warrantyAr     String
  specs          String // JSON: [{ label, labelAr, value, valueAr }]

  images     ProductImage[]
  finishes   ProductFinish[]
  sizes      ProductSize[]
  orderItems OrderItem[]
  favorites  Favorite[]
  configs    Configuration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([featured])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  finishKey String? // when the shot belongs to a specific finish
  sortOrder Int     @default(0)

  @@index([productId])
}

model ProductFinish {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key        String // wood | matte | gloss | navy | olive | walnut ...
  label      String
  labelAr    String
  swatch     String // hex
  imageUrl   String
  priceDelta Int     @default(0)
  sortOrder  Int     @default(0)

  @@unique([productId, key])
  @@index([productId])
}

model ProductSize {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label      String // "80cm"
  cm         Int
  priceDelta Int     @default(0)
  sortOrder  Int     @default(0)

  @@unique([productId, label])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  phone        String?
  passwordHash String
  role         String  @default("USER") // USER | ADMIN

  orders    Order[]
  carts     Cart[]
  favorites Favorite[]
  configs   Configuration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------

model Cart {
  id     String  @id @default(cuid())
  token  String  @unique
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  finishKey String
  sizeLabel String
  quantity  Int    @default(1)
  unitPrice Int

  // snapshot so the cart survives catalog edits
  name     String
  nameAr   String
  slug     String
  imageUrl String

  configId String? // link to a Configuration built in the Lab

  createdAt DateTime @default(now())

  @@unique([cartId, productId, finishKey, sizeLabel, configId])
  @@index([cartId])
}

// ---------------------------------------------------------------------------
// Customisation lab
// ---------------------------------------------------------------------------

model Configuration {
  id        String   @id @default(cuid())
  code      String   @unique
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  finishKey String
  sizeLabel String
  hardware  String // brushed | black | gold
  basin     String // integrated | vessel | double
  notes     String?
  price     Int
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id     String @id @default(cuid())
  number String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  customerName  String
  customerEmail String
  customerPhone String

  addressLine String
  city        String
  governorate String
  postalCode  String?
  notes       String?

  subtotal Int
  shipping Int
  total    Int

  paymentMethod String @default("cod") // cod | bank
  status        String @default("pending") // pending | confirmed | in_production | shipped | delivered | cancelled

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  name      String
  nameAr    String
  slug      String
  imageUrl  String
  finishKey String
  sizeLabel String
  quantity  Int
  unitPrice Int
  lineTotal Int
  configId  String?

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Marketing / support
// ---------------------------------------------------------------------------

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("new") // new | read | closed
  createdAt DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String   @default("en")
  createdAt DateTime @default(now())
}
